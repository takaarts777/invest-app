// Prisma schema for the investment analytics app.
//
// Using Postgres (Neon) so this can run on Vercel, whose filesystem
// isn't persistent (SQLite would lose its data between deploys/cold
// starts). `url` should be Neon's pooled connection string (used at
// runtime, including by Vercel's serverless functions); `directUrl`
// should be the non-pooled one (used only by `prisma migrate`, which
// needs a direct connection rather than one going through PgBouncer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType {
  US_STOCK
  LEVERAGED_ETF
  CRYPTO
}

// A login account. Each user has their own fully separate watchlist —
// see WatchlistItem.userId. Created via /setup (only when no users exist
// yet) or by an existing user from the /users management page.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // The user's own Anthropic API key (AES-256-GCM encrypted at rest with
  // ENCRYPTION_KEY — see lib/crypto.ts), used for their sentiment/
  // rationale analyses so Claude usage is billed to their own Anthropic
  // account rather than the app owner's. Null means "not set": analysis
  // still runs, just without the AI-generated summary/rationale.
  anthropicApiKeyEncrypted String?

  watchlistItems   WatchlistItem[]
  simulatorAccount SimulatorAccount?
}

// One paper-trading account per user, seeded with a fixed starting
// balance. cashJpy is the only mutable field here — everything else
// (holdings, history) lives in the related models.
model SimulatorAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashJpy   Float    @default(500000)
  createdAt DateTime @default(now())

  positions SimulatorPosition[]
  trades    SimulatorTrade[]
}

// A current paper-trading position (quantity + running average cost).
// Deleted once quantity reaches 0 via a sell.
model SimulatorPosition {
  id          String           @id @default(cuid())
  accountId   String
  account     SimulatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol      String
  assetType   AssetType
  providerId  String
  displayName String?
  quantity    Float
  avgCostJpy  Float // average cost per unit, in JPY

  @@unique([accountId, symbol, assetType])
}

// An immutable log entry for one simulated buy or sell, so trade history
// and realized P&L can be shown even after a position is fully closed.
model SimulatorTrade {
  id               String           @id @default(cuid())
  accountId        String
  account          SimulatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol           String
  assetType        AssetType
  side             String // "BUY" | "SELL"
  quantity         Float
  priceUsd         Float // execution price per unit, USD
  usdJpyRate       Float // rate used to convert this trade to JPY
  amountJpy        Float // total JPY value of this trade (quantity * priceUsd * usdJpyRate)
  realizedPnlJpy   Float? // set only for SELL trades
  executedAt       DateTime @default(now())

  @@index([accountId, executedAt])
}

// A ticker one user is watching.
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Symbol as entered/displayed to the user, e.g. "AAPL", "TQQQ", "BTC".
  symbol      String
  assetType   AssetType
  displayName String?
  // Provider-specific lookup key:
  // - US_STOCK / LEVERAGED_ETF: the ticker as Yahoo Finance expects it, e.g. "AAPL"
  // - CRYPTO: the CoinGecko coin id, e.g. "bitcoin" (resolved at add time)
  providerId  String
  addedAt     DateTime @default(now())

  // Current holding, if any — this is a snapshot of your position now,
  // not a transaction ledger. Both null means "watching only, not held".
  // Set together via PATCH /api/watchlist/[id]; the portfolio page only
  // lists items where quantity is set.
  quantity   Float?
  avgCostUsd Float? // average cost per unit, in USD

  snapshots AnalysisSnapshot[]

  // Uniqueness is per-user now — two different users can each watch AAPL.
  @@unique([userId, symbol, assetType])
}

// A computed analysis result for a watchlist item, cached so the dashboard
// and detail page don't need to recompute/refetch on every view.
model AnalysisSnapshot {
  id              String   @id @default(cuid())
  watchlistItemId String
  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  technicalScore   Float?
  fundamentalScore Float?
  sentimentScore   Float? // raw crowd-sentiment reading ("Dumb Money"); composite uses its sign-flipped contrarian value
  anomalyScore     Float?
  smartMoneyScore  Float? // insider buy/sell reading ("Smart Money"), US stocks only
  compositeScore   Float?
  compositeLabel   String?
  // "bullish" | "bearish" | null — set when analyzeAnomaly detects an RSI/
  // price divergence, so the dashboard can badge it without parsing
  // rawDetails JSON for every watchlist row.
  divergenceSignal String?

  // LLM-generated rationale grounded in the scores/metrics above.
  rationale String?

  // Raw per-axis metrics (indicator values, fundamentals, news items,
  // anomaly flags) kept as JSON for display and for grounding the LLM.
  rawDetails String?

  @@index([watchlistItemId, computedAt])
}
